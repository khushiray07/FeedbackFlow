# Copy to .env in the repository root. Never commit real credentials.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/feedbackflow
# Required: a strong random secret of at least 32 bytes. Never use a VITE_ prefix.
JWT_SECRET=
# APP_ORIGIN must exactly match the browser origin (no trailing slash).
# Production requires HTTPS; mutations without a matching Origin are rejected.
# On Render, set NODE_ENV=production and APP_ORIGIN to the exact public HTTPS origin.
# Use a separate Atlas URI with an explicit production database path such as
# /feedbackflow_prod. Production startup rejects omitted, test, and feedbackflow
# database names. Store the production URI and a separate JWT_SECRET in Render.

# npm test starts its own disposable local MongoDB process.
# No test URI or Atlas credentials are needed. MONGODB_URI and
# MONGODB_TEST_URI are ignored by tests; no external database is supported.
# First install/test may download a MongoDB binary and requires network access.

# Optional, only for npm run seed:admin --workspace server.
# Set locally, then remove the password after setup. Never put it in shell arguments.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
