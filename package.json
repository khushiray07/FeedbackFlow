{
  "name": "feedbackflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24.11.1 <25" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "lint": "eslint .",
    "test": "npm test --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.0.0"
  }
}
